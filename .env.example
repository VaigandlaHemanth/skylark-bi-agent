# ---- Model (pick ONE; the app uses whichever key is present) --------------
# Google AI Studio - free tier, no credit card:  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternatives
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini        # force a provider when several keys are set

# ---- monday.com (read only) ----------------------------------------------
# monday.com -> avatar -> Developers -> My access tokens
MONDAY_API_TOKEN=

# Optional. Omit and the app auto-detects the boards by name
# ("work order" / "deal"). Run `npm run inspect:boards` to list ids.
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=
